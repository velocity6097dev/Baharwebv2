                            <div contenteditable="true" class="editable-field" style="font-weight:bold; text-align:left;">DESCRIPTION</div>
                        </th>
                        <th>
                            <div class="col-controls no-print">
                                <select class="col-type-select" onchange="syncSelect(this); calculateAll();">
                                    <option value="text">Text Info</option>
                                    <option value="qty" selected>Quantity</option>
                                    <option value="rate">Rate</option>
                                    <option value="amount">Amount</option>
                                </select>
                                <button class="btn-del-col" onclick="deleteColumn(this)">X</button>
                            </div>
                            <div contenteditable="true" class="editable-field" style="font-weight:bold; text-align:center;">QUANTITY</div>
                        </th>
                        <th>
                            <div class="col-controls no-print">
                                <select class="col-type-select" onchange="syncSelect(this); calculateAll();">
                                    <option value="text">Text Info</option>
                                    <option value="qty">Quantity</option>
                                    <option value="rate">Rate</option>
                                    <option value="amount" selected>Amount</option>
                                </select>
                                <button class="btn-del-col" onclick="deleteColumn(this)">X</button>
                            </div>
                            <div contenteditable="true" class="editable-field" style="font-weight:bold; text-align:center;">AMOUNT (₹)</div>
                        </th>
                        <th class="action-col no-print">Del</th>
                    </tr>
                </thead>
                <tbody id="invoiceTableBody">
                    </tbody>
                <tbody>
                    <tr style="height: 10px; border: none;"><td colspan="4" style="border: none; padding: 0;"></td></tr>
                </tbody>
                <tbody id="adjustmentsBody">
                    <tr class="total-row" id="grossTotalRow" style="font-weight:bold; border-top: 2px solid #000; background-color: #f1f5f9;">
                    </tr>
                </tbody>
                <tbody>
                    <tr>
                        <td class="footer-desc-cell" style="text-align: right;">Rounding Off (+/-)</td>
                        <td id="roundingOutput" style="text-align: right; width:120px;">0.00</td>
                        <td class="action-col no-print"></td>
                    </tr>
                    <tr class="total-row" style="font-weight:bold; font-size:1.1rem; color:#004b87; background-color: #f1f5f9;">
                        <td class="footer-desc-cell" style="text-align: right;">FINAL NET PAYABLE</td>
                        <td style="text-align: right; width:120px;">₹<span id="finalNetOutput">0.00</span></td>
                        <td class="action-col no-print"></td>
                    </tr>
                </tbody>
            </table>

            <div style="text-align: right; margin-top: 35px; padding-right: 15px; page-break-inside: avoid;">
                <div style="display: inline-block; text-align: center;">
                    <p style="margin: 0;">Yours faithfully,</p>
                    <br><br>
                    <strong contenteditable="true" class="editable-field" style="width: auto; padding: 0;">M/S. Bahar Service Station</strong>
                </div>
            </div>

            <div class="controls-row no-print" style="justify-content: center; margin-top: 25px;">
                <button class="btn-small btn-action" onclick="addItemRow()">+ Add Item Row</button>
                <button class="btn-small" style="background:#0f766e;" onclick="addColumn()">+ Add Column</button>
                <button class="btn-small" style="background:#8b5cf6;" onclick="addAdjustmentRow()">+ Add Tax/Deduct</button>
                <button class="btn-small" style="background:#ef4444;" onclick="viewInvoicePreview()"><i class="fa-solid fa-file-pdf"></i> Preview PDF</button>
            </div>
        </div>
    </div>


    <div class="modal-overlay" id="previewModal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3 id="modalTitle"><i class="fa-solid fa-file-pdf" style="color: #ef4444;"></i> Invoice Preview</h3>
                <div style="display: flex; gap: 15px; align-items: center;">
                    <button class="btn-small btn-success" style="background: #10b981;" onclick="downloadPDFFromPreview()" id="modalDownloadBtn"><i class="fa-solid fa-download"></i> Download PDF</button>
                    <button class="close-btn" onclick="closeModal(event)">&times;</button>
                </div>
            </div>
            <div class="modal-body">
                <div class="preview-paper" id="previewContent">
                </div>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="../js/header.js"></script>
    <script src="../js/pad-header.js"></script>
    <script src="../js/ribbon.js"></script>

    <script>
        function calculateAll() {
            let qtyIdx = -1, rateIdx = -1, amountIdx = -1;
            const headers = document.querySelectorAll('#tableHeaderRow th');
            const colCount = headers.length - 1;

            headers.forEach((th, idx) => {
                const select = th.querySelector('.col-type-select');
                if (select) {
                    if (select.value === 'qty') qtyIdx = idx;
                    if (select.value === 'rate') rateIdx = idx;
                    if (select.value === 'amount') amountIdx = idx;
                }
            });

            let totalQty = 0;
            let grossTotal = 0;

            document.querySelectorAll('.item-row').forEach(row => {
                const cells = row.children;
                let rowQty = 0, rowRate = 0, rowAmount = 0;

                if (qtyIdx > -1 && cells[qtyIdx]) {
                    const field = cells[qtyIdx].querySelector('.editable-field');
                    if(field) {
                        rowQty = parseFloat(field.textContent.replace(/[^0-9.-]/g, '')) || 0;
                        totalQty += rowQty;
                    }
                }
                if (rateIdx > -1 && cells[rateIdx]) {
                    const field = cells[rateIdx].querySelector('.editable-field');
                    if(field) rowRate = parseFloat(field.textContent.replace(/[^0-9.-]/g, '')) || 0;
                }
                
                if (qtyIdx > -1 && rateIdx > -1) {
                    rowAmount = rowQty * rowRate;
                    if (amountIdx > -1 && cells[amountIdx]) {
                        const field = cells[amountIdx].querySelector('.editable-field');
                        if(field) field.textContent = rowAmount.toFixed(2);
                    }
                } else if (amountIdx > -1 && cells[amountIdx]) {
                    const field = cells[amountIdx].querySelector('.editable-field');
                    if(field) rowAmount = parseFloat(field.textContent.replace(/[^0-9.-]/g, '')) || 0;
                }

                grossTotal += rowAmount;
            });

            const grossTotalRow = document.getElementById('grossTotalRow');
            grossTotalRow.innerHTML = '';
            for(let i = 0; i < colCount; i++) {
                const td = document.createElement('td');
                if (i === 0) { td.innerText = "GROSS TOTAL"; td.style.textAlign = "left"; }
                else if (i === qtyIdx) { td.innerText = totalQty.toFixed(2); td.style.textAlign = "right"; td.style.fontWeight = "bold"; }
                else if (i === amountIdx) { td.innerText = grossTotal.toFixed(2); td.style.textAlign = "right"; td.style.fontWeight = "bold"; }
                else { td.innerText = ""; }
                grossTotalRow.appendChild(td);
            }
            grossTotalRow.insertAdjacentHTML('beforeend', '<td class="action-col no-print"></td>');

            let descColspan = Math.max(1, colCount - 1);
            document.querySelectorAll('.adj-desc-cell').forEach(c => c.colSpan = descColspan);
            document.querySelectorAll('.footer-desc-cell').forEach(c => c.colSpan = descColspan);

            let netTotal = grossTotal;
            document.querySelectorAll('.adj-row').forEach(row => {
                let operator = row.querySelector('.operator-select').value;
                let valStr = row.querySelector('.val-adj').textContent.replace(/[^0-9.-]/g, '');
                let val = parseFloat(valStr) || 0;

                if (operator === '+') netTotal += val;
                else if (operator === '-') netTotal -= val;
                else if (operator === '+%') netTotal += (grossTotal * (val / 100));
                else if (operator === '-%') netTotal -= (grossTotal * (val / 100));
            });

            let finalNet = Math.round(netTotal);
            let rounding = finalNet - netTotal;

            document.getElementById('roundingOutput').innerText = (rounding > 0 ? "+" : "") + rounding.toFixed(2);
            document.getElementById('finalNetOutput').innerText = finalNet.toFixed(2);
        }

        function addColumn() {
            const theadTr = document.getElementById('tableHeaderRow');
            const actionTh = theadTr.lastElementChild;
            const newTh = document.createElement('th');
            newTh.innerHTML = `
                <div class="col-controls no-print">
                    <select class="col-type-select" onchange="syncSelect(this); calculateAll();">
                        <option value="text">Text Info</option>
                        <option value="qty">Quantity</option>
                        <option value="rate" selected>Rate</option>
                        <option value="amount">Amount</option>
                    </select>
                    <button class="btn-del-col" onclick="deleteColumn(this)">X</button>
                </div>
                <div contenteditable="true" class="editable-field" style="font-weight:bold; text-align:center;" data-placeholder="New Col">RATE (₹)</div>
            `;
            theadTr.insertBefore(newTh, actionTh);

            document.querySelectorAll('.item-row').forEach(row => {
                const actionTd = row.lastElementChild;
                const newTd = document.createElement('td');
                newTd.innerHTML = `<div contenteditable="true" class="editable-field val-rate" style="text-align:right;" data-placeholder="0.00"></div>`;
                row.insertBefore(newTd, actionTd);
            });
            calculateAll();
        }

        function deleteColumn(btn) {
            const th = btn.closest('th');
            const tr = th.parentElement;
            const idx = Array.from(tr.children).indexOf(th);
            th.remove();
            document.querySelectorAll('.item-row').forEach(row => {
                if(row.children[idx]) row.children[idx].remove();
            });
            calculateAll();
        }

        function addItemRow() {
            const tbody = document.getElementById('invoiceTableBody');
            const tr = document.createElement('tr');
            tr.className = 'item-row';
            const colCount = document.querySelectorAll('#tableHeaderRow th').length - 1;
            
            let html = '';
            for(let i=0; i<colCount; i++) {
                html += `<td><div contenteditable="true" class="editable-field" style="text-align:${i===0 ? 'left' : 'right'};" data-placeholder="${i===0 ? 'Description...' : '0.00'}"></div></td>`;
            }
            html += `<td class="action-col no-print"><button class="btn-small btn-clear" onclick="deleteRow(this)">X</button></td>`;
            tr.innerHTML = html;
            tbody.appendChild(tr);
            calculateAll();
        }

        function addAdjustmentRow() {
            const tbody = document.getElementById('adjustmentsBody');
            const tr = document.createElement('tr');
            tr.className = 'adj-row';
            tr.innerHTML = `
                <td class="adj-desc-cell" style="text-align: right;">
                    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px;">
                        <div contenteditable="true" class="editable-field" style="text-align: right;" data-placeholder="Desc (e.g. GST +18%)"></div>
                        <select class="operator-select no-print" onchange="syncSelect(this); calculateAll();">
                            <option value="-">- Amt</option>
                            <option value="+">+ Amt</option>
                            <option value="-%">-% Pct</option>
                            <option value="+%">+% Pct</option>
                        </select>
                    </div>
                </td>
                <td style="width:120px; text-align: right;"><div contenteditable="true" class="editable-field val-adj" style="text-align: right;" data-placeholder="0.00"></div></td>
                <td class="action-col no-print"><button class="btn-small btn-clear" onclick="deleteRow(this)">X</button></td>
            `;
            tbody.appendChild(tr);
            calculateAll();
        }

        function deleteRow(btn) { btn.closest('tr').remove(); calculateAll(); }

        function syncSelect(selectElem) {
            Array.from(selectElem.options).forEach(opt => opt.removeAttribute('selected'));
            selectElem.options[selectElem.selectedIndex].setAttribute('selected', 'selected');
        }

        function viewInvoicePreview() {
            const element = document.getElementById('printableInvoice');
            const noPrintElements = element.querySelectorAll('.no-print');
            noPrintElements.forEach(el => el.style.display = 'none');
            const previewHTML = element.innerHTML;
            noPrintElements.forEach(el => el.style.display = '');
            document.getElementById('previewContent').innerHTML = previewHTML;
            document.getElementById('previewModal').style.display = 'flex';
        }

        function closeModal(event) { document.getElementById('previewModal').style.display = 'none'; }

        async function downloadPDFFromPreview() {
            const btn = document.getElementById('modalDownloadBtn');
            btn.innerHTML = '<i class="fa-solid fa-hourglass-half"></i> Generating...';
            
            const element = document.querySelector('.preview-paper');
            const originalShadow = element.style.boxShadow;
            element.style.boxShadow = 'none';

            const opt = {
                margin:        [15, 15, 20, 15],
                filename:      'Bahar_Fuel_Invoice.pdf',
                image:         { type: 'jpeg', quality: 1 },
                html2canvas:   { scale: 2, useCORS: true, windowWidth: 850 },
                jsPDF:         { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            try {
                await html2pdf().set(opt).from(element).toPdf().get('pdf').then(function (pdf) {
                    const totalPages = pdf.internal.getNumberOfPages();
                    for (let i = 1; i <= totalPages; i++) {
                        pdf.setPage(i);
                        pdf.setFontSize(10);
                        pdf.setTextColor(100);
                        const text = `Page ${i} of ${totalPages}`;
                        const pageWidth = pdf.internal.pageSize.getWidth();
                        const pageHeight = pdf.internal.pageSize.getHeight();
                        const textWidth = pdf.getStringUnitWidth(text) * pdf.internal.getFontSize() / pdf.internal.scaleFactor;
                        pdf.text(text, (pageWidth - textWidth) / 2, pageHeight - 10);
                    }
                }).save();
                
                element.style.boxShadow = originalShadow;
                btn.innerHTML = '<i class="fa-solid fa-download"></i> Download PDF';
            } catch (err) {
                console.error(err);
                alert("Error generating PDF. Please try again.");
                element.style.boxShadow = originalShadow;
                btn.innerHTML = '<i class="fa-solid fa-download"></i> Download PDF';
            }
        }

        // --- MONGODB INTEGRATION --- //

        // 1. Save Document (Sends HTML to Express API)
        window.saveDocument = async function() {
            let templateName = prompt("Enter a name for this template (e.g., 'Monthly BPCL Fuel', 'Standard Tata Truck'):");
            if (!templateName || templateName.trim() === "") return;
            
            if (window.getSelection) window.getSelection().removeAllRanges();
            document.querySelectorAll('select').forEach(sel => syncSelect(sel));
            
            const invoiceHTML = document.getElementById('printableInvoice').innerHTML;
            
            try {
                const response = await fetch('/api/templates/invoice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        templateName: templateName.trim(),
                        invoiceType: 'fuel',
                        htmlData: invoiceHTML
                    })
                });
                
                const result = await response.json();
                if (result.success) {
                    alert(`Template "${templateName}" saved to Database successfully!`);
                } else {
                    alert("Error saving template to database.");
                }
            } catch (error) {
                console.error("Database connection failed:", error);
                alert("Failed to connect to the server. Is Node.js running?");
            }
        };

        // 2. Load a specific template from the database based on URL query
        async function loadSpecificTemplate(name) {
            try {
                const res = await fetch(`/api/templates/invoice/${encodeURIComponent(name)}`);
                if (!res.ok) throw new Error("Template not found");
                
                const data = await res.json();
                if(data.htmlData) {
                    document.getElementById('printableInvoice').innerHTML = data.htmlData;
                    
                    // Re-sync dropdowns to their saved visual states
                    document.querySelectorAll('#printableInvoice select').forEach(sel => {
                        const selectedOpt = sel.querySelector('option[selected]');
                        if(selectedOpt) sel.value = selectedOpt.value;
                    });
                    
                    setupEventListeners();
                    calculateAll();
                }
            } catch (err) {
                console.error("Failed to load template:", err);
                alert("Could not load the specified template. Starting with a blank document.");
                startBlank();
            }
        }

        // 3. Initialize a blank workspace
        function startBlank() {
            if (typeof injectBaharHeader === 'function') {
                injectBaharHeader(); // Insert the default letterhead if starting blank
            }
            setupEventListeners();
            calculateAll();
        }

        function clearInvoice() {
            if(confirm("Are you sure you want to completely reset? Any unsaved changes will be lost.")) {
                // Strips out the ?template= parameter and reloads the page blank
                window.location.href = window.location.pathname; 
            }
        }

        // Attach live calculation listeners
        function setupEventListeners() {
            const invoiceArea = document.getElementById('printableInvoice');
            invoiceArea.removeEventListener('input', calculateAll);
            invoiceArea.removeEventListener('keyup', calculateAll);
            invoiceArea.addEventListener('input', calculateAll);
            invoiceArea.addEventListener('keyup', calculateAll);
        }

        // On Page Load: Check URL for template parameter, otherwise start blank
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const templateName = urlParams.get('template');
            
            if (templateName) {
                loadSpecificTemplate(templateName);
            } else {
                startBlank();
            }
        });

    </script>
</body>
