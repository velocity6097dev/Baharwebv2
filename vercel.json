{
  "version": 2,
  "builds": [
    {
      "src": "Backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/Backend/server.js" },
    { "source": "/", "destination": "/frontend/pages/index.html" },
    { "source": "/(.*\\.html)", "destination": "/frontend/pages/$1" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
